# Copy to .env and fill in. .env is gitignored: it must never hold the key itself.
#
# Upstream API key — a POINTER to an SSM SecureString you created yourself:
#
#   aws ssm put-parameter --name /lambda-decide/jev/api-key --type SecureString \
#     --value "$(cat ~/.jev-api-key)" --overwrite --profile burner --region us-east-1
#
DECIDE_API_KEY_SSM=/lambda-decide/jev/api-key

# Which decision backend to deploy against: typesafe | openrouter | vercel (default openrouter).
# Any of them works; "typesafe" is just the one this repo deploys against.
DECIDE_BACKEND=typesafe
# ...or point at any server speaking /v1/systemone (self-hosted Von/Laya, another gateway):
# DECIDE_BACKEND_URL=http://localhost:8000
# DECIDE_BACKEND_MODEL=von-1.0.0

# Nothing about your own gateway belongs here. Its URL is a deploy-time value that cannot be
# known before the stack exists — read the "GatewayUrl" output instead:
#
#   aws cloudformation describe-stacks --stack-name DecisionGateway --profile burner \
#     --query "Stacks[0].Outputs[?OutputKey=='GatewayUrl'].OutputValue" --output text
